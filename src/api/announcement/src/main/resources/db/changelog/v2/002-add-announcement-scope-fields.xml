<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.30.xsd">
    <changeSet id="002-add-announcement-scope-fields" author="opencode-eng">
        <preConditions onFail="MARK_RAN"><tableExists tableName="announcements"/></preConditions>
        <addColumn tableName="announcements">
            <column name="church_id" type="BIGINT"/>
            <column name="created_by_user_id" type="BIGINT"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
