<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.30.xsd">

    <changeSet id="006-create-user-permissions-join-table" author="hemen.hirekaan">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_permissions"/>
            </not>
        </preConditions>
        <createTable tableName="user_permissions">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_user_permissions_user" references="users(id)"/>
            </column>
            <column name="permission_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_user_permissions_permission" references="permissions(id)"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="user_permissions"
                columnNames="user_id, permission_id"
                constraintName="pk_user_permissions"/>
    </changeSet>

</databaseChangeLog>
